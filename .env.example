# Copy this file to `.env` and fill in the values. Restart `npm run dev` after changing it.
# These are server-only values: they are never added to the website's JavaScript.

# Gmail account that sends the enquiry emails
GMAIL_USER=umiyaenterprisealu@gmail.com
# 16-character Gmail App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_APP_PASSWORD=

# Optional: inbox that receives enquiries (defaults to enquiryInbox in src/data/site.js)
ENQUIRY_TO=
# Optional: public website address, shows a "Visit Website" button in the customer email
SITE_URL=
